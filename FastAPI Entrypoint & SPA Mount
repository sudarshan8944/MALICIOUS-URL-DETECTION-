        if db.query(URLScan).count() == 0:
            print("[*] Seeding initial URL scans from dataset...")
            curated_samples = [
                "https://google.com",
                "http://secure-login-example.xyz/account",
                "http://192.168.1.1/admin/login.php",
                "https://wikipedia.org/wiki/Cybersecurity",
                "http://bit.ly/claim-free-paypal-bonus-now",
                "http://www.garage-pirenne.be/index.php?option=com_content&view=article&id=70",
                "https://github.com/torvalds/linux",
                "http://br-icloud.com.br",
                "http://buzzfil.net/m/show-art/ils-etaient-loin-de-s-imaginer",
                "http://secure3ds.h19.ru/verify-account",
                "https://stackoverflow.com/questions/malicious-url-detection",
                "http://ebasy.xgsm.pl?eBay.com.wbdllsc.login.submit",
                "https://fastapi.tiangolo.com",
                "http://steamglfts.h16.ru/free-csgo-skins",
                "http://paypal-verification-update.secure-portal.info/login"
            ]

            admin_u = db.query(User).filter(User.Role == "admin").first()
            uid = admin_u.User_ID if admin_u else None
            now = datetime.utcnow()

            for idx, u in enumerate(curated_samples):
                res = ml_engine.analyze_url(u)
                time_offset = timedelta(days=random.randint(0, 6), hours=random.randint(0, 23))
                record = URLScan(
                    User_ID=uid,
                    URL=res['url'],
                    Risk_Score=res['risk_score'],
                    Classification=res['classification'],
                    Threat_Type=res['threat_type'],
                    ML_Probability=res['ml_probability'],
                    Features_JSON=json.dumps(res['features']),
                    Checklist_JSON=json.dumps(res['checklist']),
                    Recommendation=res['recommendation'],
                    Scan_Date=now - time_offset
                )
                db.add(record)

            db.commit()
            print("[OK] Initial URL scans seeded.")
    except Exception as e:
        print(f"[!] Error seeding initial data: {e}")
    finally:
        db.close()

