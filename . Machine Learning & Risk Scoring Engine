import os
import json
import joblib
import pandas as pd
from typing import Dict, Any
from .feature_extractor import extract_url_features

MODEL_PATH = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'ml_model', 'model.joblib'))
META_PATH = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'ml_model', 'model_meta.json'))

# Well-known trusted top domains
TRUSTED_TOP_DOMAINS = {
    'google.com', 'www.google.com', 'youtube.com', 'www.youtube.com',
    'microsoft.com', 'www.microsoft.com', 'apple.com', 'www.apple.com',
    'github.com', 'www.github.com', 'amazon.com', 'www.amazon.com',
    'wikipedia.org', 'en.wikipedia.org', 'linkedin.com', 'www.linkedin.com',
    'cloudflare.com', 'mozilla.org', 'stackoverflow.com', 'fastapi.tiangolo.com',
    'python.org', 'react.dev', 'npmjs.com', 'cnn.com', 'bbc.com', 'nytimes.com',
    'mit.edu', 'stanford.edu', 'harvard.edu', 'gov', 'who.int'
}

class MLEngine:
    _instance = None

    def __init__(self):
        self.model_data = None
        self.model = None
        self.feature_names = []
        self.metadata = {}
        self.load_model()

    @classmethod
    def get_instance(cls):
        if cls._instance is None:
            cls._instance = MLEngine()
        return cls._instance

    def load_model(self):
        try:
            if os.path.exists(MODEL_PATH):
                self.model_data = joblib.load(MODEL_PATH)
                self.model = self.model_data['model']
                self.feature_names = self.model_data['feature_names']
                print(f"[*] Loaded trained ML model from {MODEL_PATH}")
            else:
                print(f"[!] Warning: Model file {MODEL_PATH} not found. Running in heuristic mode.")
                
            if os.path.exists(META_PATH):
                with open(META_PATH, 'r') as f:
                    self.metadata = json.load(f)
        except Exception as e:
            print(f"[!] Error loading model: {e}")

    def analyze_url(self, raw_url: str) -> Dict[str, Any]:
        raw_url = raw_url.strip()
        analysis = extract_url_features(raw_url)
        features_dict = analysis['features']
        details = analysis['details']
        hostname = details['hostname']
        
        # Check if root domain or subdomain is a trusted authority
        is_trusted = False
        for td in TRUSTED_TOP_DOMAINS:
            if hostname == td or hostname.endswith('.' + td):
                is_trusted = True
                break

        # 1. Base ML model prediction
        ml_prob = 0.5
        if self.model and self.feature_names:
            feat_df = pd.DataFrame([features_dict])[self.feature_names]
            probs = self.model.predict_proba(feat_df)[0]
            ml_prob = float(probs[1]) if len(probs) > 1 else float(probs[0])

        base_ml_score = ml_prob * 100.0

        # 2. Cybersecurity Heuristic Risk Assessment
        heuristic_score = 0.0

        if not details['has_https']:
            heuristic_score += 15.0
            
        if details['has_suspicious_keywords']:
            heuristic_score += min(35.0, len(details['matched_keywords']) * 14.0)

        if details.get('brand_spoofed', False):
            heuristic_score += 40.0

        if details['is_ip_domain']:
            heuristic_score += 45.0

        if details['is_shortened']:
            heuristic_score += 25.0

        if details['multiple_subdomains']:
            heuristic_score += 15.0
        if details['is_long_url']:
            heuristic_score += 12.0
        if details['high_entropy']:
            heuristic_score += 12.0
        if details['has_double_slash_redirect']:
            heuristic_score += 30.0

        suspicious_tlds = ('.xyz', '.top', '.tk', '.work', '.click', '.loan', '.gq', '.cf', '.ga', '.ml', '.club')
        is_suspicious_tld = any(hostname.endswith(tld) for tld in suspicious_tlds)
        if is_suspicious_tld:
            heuristic_score += 20.0

        # 3. Blended Risk Calculation
        if is_trusted and not details.get('brand_spoofed', False) and not details['has_double_slash_redirect']:
            final_risk_score = min(20, int(round((base_ml_score * 0.15) + (heuristic_score * 0.2))))
        else:
            raw_calculated = (base_ml_score * 0.50) + (heuristic_score * 0.50)
            
            critical_hits = sum([
                details['is_ip_domain'],
                details.get('brand_spoofed', False),
                details['has_suspicious_keywords'] and not details['has_https'],
                is_suspicious_tld and details['has_suspicious_keywords'],
                details['has_double_slash_redirect']
            ])
            if critical_hits >= 2:
                raw_calculated = max(78.0, raw_calculated)
            elif critical_hits == 1:
                raw_calculated = max(55.0, raw_calculated)
                
            final_risk_score = int(round(max(0.0, min(100.0, raw_calculated))))

        # 4. Classification thresholds (0-30: Safe, 31-70: Suspicious, 71-100: Malicious)
        if final_risk_score <= 30:
            classification = "Safe"
            threat_level = "LOW"
            threat_color = "emerald"
        elif final_risk_score <= 70:
            classification = "Suspicious"
            threat_level = "MEDIUM"
            threat_color = "amber"
        else:
            classification = "Malicious"
            threat_level = "HIGH"
            threat_color = "rose"

        threat_type = "Legitimate"
        if classification != "Safe":
            if details['is_ip_domain']:
                threat_type = "Direct IP Attack / C2 Server"
            elif details.get('brand_spoofed', False) or (details['has_suspicious_keywords'] and any(k in details['matched_keywords'] for k in ['login', 'account', 'verify', 'bank', 'signin', 'password', 'wallet'])):
                threat_type = "Phishing / Credential Harvesting"
            elif details['is_shortened']:
                threat_type = "Obfuscated / Shortened URL Threat"
            elif details['has_double_slash_redirect'] or 'option=com_' in raw_url:
                threat_type = "Defacement / Redirection Exploit"
            elif details['high_entropy'] or features_dict['digit_ratio'] > 0.35:
                threat_type = "Malware Distribution Host"
            else:
                threat_type = "Suspicious Domain / Threat Candidate"

        # Checklist for user dashboard
        checklist = {
            "https": {
                "label": "HTTPS Encryption",
                "status": "PASS" if details['has_https'] else "FAIL",
                "icon": "✅" if details['has_https'] else "❌",
                "text": "Valid HTTPS protocol present" if details['has_https'] else "Unencrypted HTTP protocol in use"
            },
            "suspicious_keywords": {
                "label": "Suspicious Keywords",
                "status": "FAIL" if details['has_suspicious_keywords'] else "PASS",
                "icon": "⚠️" if details['has_suspicious_keywords'] else "✅",
                "text": f"Found sensitive keywords: {', '.join(details['matched_keywords'])}" if details['has_suspicious_keywords'] else "No suspicious keywords detected"
            },
            "url_length": {
                "label": "URL Length",
                "status": "WARN" if details['is_long_url'] else "PASS",
                "icon": "⚠️" if details['is_long_url'] else "✅",
                "text": f"Abnormally long URL ({features_dict['url_length']} chars)" if details['is_long_url'] else f"Normal length ({features_dict['url_length']} chars)"
            },
            "subdomains": {
                "label": "Subdomain Structure",
                "status": "WARN" if details['multiple_subdomains'] else "PASS",
                "icon": "⚠️" if details['multiple_subdomains'] else "✅",
                "text": f"Multiple nested subdomains ({details['subdomain_count']})" if details['multiple_subdomains'] else "Standard domain hierarchy"
            },
            "domain_credibility": {
                "label": "Domain Credibility",
                "status": "FAIL" if (details['is_ip_domain'] or details['is_shortened'] or is_suspicious_tld or details.get('brand_spoofed', False)) else "PASS",
                "icon": "❌" if (details['is_ip_domain'] or details['is_shortened'] or is_suspicious_tld or details.get('brand_spoofed', False)) else "✅",
                "text": "Raw IP address used as hostname" if details['is_ip_domain'] else (
                    "Brand impersonation / spoofing detected" if details.get('brand_spoofed', False) else (
                        "Shortened obfuscated URL service" if details['is_shortened'] else (
                            f"High-risk TLD detected ({hostname.split('.')[-1]})" if is_suspicious_tld else "Standard verified domain"
                        )
                    )
                )
            }
        }

        if classification == "Malicious":
            recommendation = "Avoid accessing the website or entering sensitive information. High probability of credential theft or malware distribution."
        elif classification == "Suspicious":
            recommendation = "Exercise extreme caution. Do not submit passwords or sensitive financial information. Verify the domain authenticity."
        else:
            recommendation = "This URL appears safe and clean. Standard web browsing precautions apply."

        return {
            "url": raw_url,
            "risk_score": final_risk_score,
            "classification": classification,
            "threat_level": threat_level,
            "threat_color": threat_color,
            "threat_type": threat_type,
            "ml_probability": round(ml_prob, 4),
            "features": features_dict,
            "details": details,
            "checklist": checklist,
            "recommendation": recommendation
        }

ml_engine = MLEngine.get_instance()
