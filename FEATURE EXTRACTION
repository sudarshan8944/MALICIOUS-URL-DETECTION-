import re
import math
from urllib.parse import urlparse

SHORTENERS = {
    'bit.ly', 'tinyurl.com', 'goo.gl', 't.co', 'is.gd', 'cli.gs',
    'yfrog.com', 'migre.me', 'ff.im', 'tiny.cc', 'url4.eu', 'twit.ac',
    'su.pr', 'twurl.nl', 'snipurl.com', 'short.to', 'BudURL.com', 'ping.fm',
    'post.ly', 'Just.as', 'bkite.com', 'snipr.com', 'fic.kr', 'loopt.us',
    'doiop.com', 'short.ie', 'kl.am', 'wp.me', 'rubyurl.com', 'om.ly',
    'to.ly', 'bit.do', 't.ly', 'cutt.ly', 'ow.ly', 'rebrand.ly', 'buff.ly'
}

# Suspicious action keywords commonly used in phishing & social engineering
SUSPICIOUS_KEYWORDS = [
    'login', 'verify', 'update', 'account', 'banking', 'secure', 'ebayisapi',
    'webscr', 'signin', 'confirm', 'security', 'wallet', 'support', 'free',
    'bonus', 'gift', 'password', 'service', 'payment', 'claim', 'credential',
    'billing', 'customer', 'auth', 'server', 'client', 'upgrade', 'validate',
    'recover', 'alert', 'access', 'suspended', 'locked', 'urgent', 'limited',
    'unusual', 'action', 'invoice', 'reset', 'passcode', 'verification'
]

# High-profile brands often targeted for phishing spoofing
TARGET_BRANDS = [
    'paypal', 'apple', 'google', 'microsoft', 'netflix', 'amazon',
    'facebook', 'instagram', 'whatsapp', 'chase', 'wellsfargo',
    'bankofamerica', 'binance', 'coinbase', 'dropbox', 'adobe', 'steam'
]

IP_PATTERN = re.compile(
    r'^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}'
    r'(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$'
)

HEX_IP_PATTERN = re.compile(r'^0x[0-9a-fA-F]+$')

def calculate_entropy(text: str) -> float:
    """Calculates Shannon entropy of a string."""
    if not text:
        return 0.0
    prob = [float(text.count(c)) / len(text) for c in dict.fromkeys(list(text))]
    return -sum([p * math.log(p) / math.log(2.0) for p in prob])

def extract_url_features(raw_url: str) -> dict:
    """
    Extracts comprehensive lexical, structural, and semantic features from a raw URL.
    Returns numeric feature vector and human-readable diagnostic metadata.
    """
    url = raw_url.strip()
    
    # Check scheme
    has_scheme = bool(re.match(r'^[a-zA-Z]+://', url))
    url_for_parsing = url if has_scheme else 'http://' + url
    
    hostname = ''
    path = ''
    query = ''
    
    try:
        parsed = urlparse(url_for_parsing)
        hostname = parsed.netloc.split(':')[0].lower() if parsed.netloc else ''
        path = parsed.path
        query = parsed.query
    except Exception:
        # Fallback for malformed URLs
        raw_no_scheme = re.sub(r'^[a-zA-Z]+://', '', url)
        parts = raw_no_scheme.split('/', 1)
        hostname = parts[0].split('?')[0].split(':')[0].lower()
        if len(parts) > 1:
            sub = parts[1].split('?', 1)
            path = '/' + sub[0]
            query = sub[1] if len(sub) > 1 else ''

    url_len = len(url)
    domain_len = len(hostname)
    path_len = len(path)
    query_len = len(query)
    
    dot_count = url.count('.')
    hyphen_count = url.count('-')
    at_count = url.count('@')
    special_chars = set("-._~:/?#[]@!$&'()*+,;%=")
    special_char_count = sum(1 for c in url if c in special_chars)
    
    digit_count = sum(1 for c in url if c.isdigit())
    digit_ratio = digit_count / url_len if url_len > 0 else 0.0
    
    is_ip = 1 if IP_PATTERN.match(hostname) or HEX_IP_PATTERN.match(hostname) else 0
    
    subdomain_parts = [p for p in hostname.split('.') if p]
    subdomain_count = max(0, len(subdomain_parts) - 2) if len(subdomain_parts) > 2 else 0
    
    has_https = 1 if url.lower().startswith('https://') else 0
    is_shortened = 1 if hostname in SHORTENERS else 0
    
    url_lower = url.lower()
    matched_keywords = [kw for kw in SUSPICIOUS_KEYWORDS if kw in url_lower]
    suspicious_keyword_count = len(matched_keywords)
    
    # Brand spoofing detection:
    # If a brand name is in the URL, but the domain does not actually belong to that brand
    brand_spoofed = 0
    spoofed_brands = []
    for brand in TARGET_BRANDS:
        if brand in url_lower:
            is_legit_brand = (
                hostname == f"{brand}.com" or hostname.endswith(f".{brand}.com") or
                hostname == f"{brand}.org" or hostname.endswith(f".{brand}.org")
            )
            if not is_legit_brand:
                brand_spoofed = 1
                spoofed_brands.append(brand)
                
    entropy = calculate_entropy(url)
    double_slash_in_path = 1 if '//' in path else 0

    return {
        'features': {
            'url_length': url_len,
            'domain_length': domain_len,
            'path_length': path_len,
            'query_length': query_len,
            'dot_count': dot_count,
            'hyphen_count': hyphen_count,
            'at_count': at_count,
            'special_char_count': special_char_count,
            'digit_count': digit_count,
            'digit_ratio': round(digit_ratio, 4),
            'has_ip': is_ip,
            'has_https': has_https,
            'subdomain_count': subdomain_count,
            'is_shortened': is_shortened,
            'suspicious_keyword_count': suspicious_keyword_count,
            'entropy': round(entropy, 4),
            'double_slash_in_path': double_slash_in_path,
        },
        'details': {
            'hostname': hostname,
            'path': path,
            'query': query,
            'has_https': bool(has_https),
            'is_ip_domain': bool(is_ip),
            'is_shortened': bool(is_shortened),
            'has_suspicious_keywords': bool(suspicious_keyword_count > 0),
            'matched_keywords': matched_keywords,
            'brand_spoofed': bool(brand_spoofed),
            'spoofed_brands': spoofed_brands,
            'multiple_subdomains': subdomain_count > 1,
            'subdomain_count': subdomain_count,
            'is_long_url': url_len > 75,
            'high_entropy': entropy > 4.2,
            'has_double_slash_redirect': bool(double_slash_in_path)
        }
    }
